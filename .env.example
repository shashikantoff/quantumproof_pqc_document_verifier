# Runtime
DATABASE_URL=postgresql+psycopg://verifier:verifier@db:5432/verifier
LEDGER_BACKEND=development
KEYSTORE_PATH=/var/lib/pqc-keys
ALLOW_INSECURE_DEMO_PQC=false
MAX_DOCUMENT_BYTES=10485760
CORS_ORIGINS=http://localhost:8080
ADMIN_ID=admin
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_ATTEMPT_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=900
# Keep false for local HTTP; set true when served over HTTPS.
ADMIN_COOKIE_SECURE=false

# Required only when starting the optional Prometheus/Alertmanager profile.
# Set this to an Alertmanager-compatible webhook endpoint; keep its secret local.
ALERT_WEBHOOK_URL=

# Used only when LEDGER_BACKEND=fabric
FABRIC_GATEWAY_URL=http://fabric-gateway:3000
FABRIC_GATEWAY_TOKEN=replace-with-a-long-random-token

# Set to measured versions when collecting benchmark results
BENCHMARK_DOCKER_VERSION=not_available
BENCHMARK_FABRIC_VERSION=not_available
BENCHMARK_POSTGRES_VERSION=not_available
BENCHMARK_ENDORSEMENT_POLICY=not_available
BENCHMARK_SOURCE_REVISION=not_available

# Public URL used for QR/verification links
PUBLIC_BASE_URL=http://localhost:8080
